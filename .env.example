# Google Maps Platform key with "Places API (New)" enabled
GOOGLE_MAPS_API_KEY=

# Supabase project
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secret Vercel Cron will send back to /api/cron/check as a Bearer token
# (set this as an env var and Vercel automatically attaches it to cron requests)
CRON_SECRET=

# Optional — get a Telegram push every time a check completes (manual or
# cron). Message @BotFather to create a bot and get TELEGRAM_BOT_TOKEN;
# message your bot once, then GET https://api.telegram.org/bot<token>/getUpdates
# to find your chat id. Leave both blank to disable Telegram pushes.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
